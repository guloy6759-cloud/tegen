generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  WORKER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DELIVERING
  COMPLETED
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  firstName  String?
  username   String?
  phone      String?
  role       Role     @default(USER)
  department String?  // Ishchi bo'lsa: "nonchi", "kolbasachi" va h.k.
  createdAt  DateTime @default(now())

  orders     Order[]
  proposals  ProductProposal[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  isActive Boolean   @default(true)
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  image       String?
  department  String?  // Ishchilar bo'limiga biriktirish uchun
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model Order {
  id         String      @id @default(uuid())
  telegramId String
  user       User        @relation(fields: [telegramId], references: [telegramId])
  items      Json
  totalPrice Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
}

// Ishchilar taklif qiladigan yangi mahsulotlar (Admin tasdiqlashi uchun)
model ProductProposal {
  id          String   @id @default(uuid())
  workerId    String
  worker      User     @relation(fields: [workerId], references: [id])
  name        String
  price       Float
  image       String?
  department  String
  categoryId  String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
